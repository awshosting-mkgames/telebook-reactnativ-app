{
  "expo": {
    "name": "Telebook",
    "slug": "Free-chat",
    "version": "0.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.telebookapp.chatapp",
      "versionCode": 5,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "USE_FULL_SCREEN_INTENT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010100"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "telebook.app",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "telebook.app",
              "pathPrefix": "/c/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "telebook",
              "host": "u"
            },
            {
              "scheme": "telebook",
              "host": "c"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 449,
          "resizeMode": "contain",
          "backgroundColor": "#010100"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Telebook to access your photos.",
          "savePhotosPermission": "Allow Telebook to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-video",
      "expo-audio",
      "expo-sqlite",
      "./plugins/withAdiRegistration",
      "./plugins/withRemoveForegroundPermissions"
    ],
    "owner": "ambujexpo25",
    "scheme": "telebook",
    "extra": {
      "eas": {
        "projectId": "ced2885f-7e3a-44cb-964c-860e2478ba7f"
      }
    }
  }
}
