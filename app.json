{
  "expo": {
    "name": "Telebook",
    "slug": "Free-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.Telebookapp.Telebook",
      "versionCode": 3,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010100"
      }
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "b62fcbf2-8282-4407-a8fe-25e110d6cd99"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 449,
          "resizeMode": "contain",
          "backgroundColor": "#010100"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Telebook to access your photos.",
          "savePhotosPermission": "Allow Telebook to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-video",
      "expo-audio",
      "expo-sqlite"
    ],
    "owner": "mmh25"
  }
}
